# AuraLingovia — environment variables template
# Copy this file to .env and fill in your values.

# ── Required (client-side) ────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Get from: Supabase Dashboard → Settings → API → anon public (the JWT key)
VITE_SUPABASE_ANON_KEY="eyJ..."

# ── Required (server-side only) ──────────────────────────────────────────
SUPABASE_URL="https://your-project-id.supabase.co"
# Get from: Supabase Dashboard → Settings → API → service_role secret key
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Optional (PDF import + essay grading + Mündlich evaluation) ──────────
# ANTHROPIC_API_KEY, if set, is preferred over Gemini for PDF import vision
# (see VISION_PROVIDER). GRADING_MODEL/essay-grader.ts (Claude) is kept as an
# unused fallback reference — the live Schreiben grader is now Gemini-based
# (essay-grader-gemini.ts, GRADING_MODEL_GEMINI below), so ANTHROPIC_API_KEY
# is no longer required for grading, only for PDF import vision if selected.
ANTHROPIC_API_KEY="sk-ant-..."
GRADING_MODEL="claude-sonnet-5"
GEMINI_API_KEY="your-gemini-api-key"
GRADING_MODEL_GEMINI="gemini-2.5-flash"
MUENDLICH_EVAL_MODEL="gemini-2.5-flash"
# "claude" or "gemini" — which PDF-import vision provider to use. Defaults to
# claude if ANTHROPIC_API_KEY is set, otherwise gemini.
VISION_PROVIDER=""

# ── Global Gemini API spend cap (see api_usage_ledger / is_api_budget_exceeded) ─
# Approximate token ceiling for combined Gemini usage (essay grading + Mündlich
# Live audio, estimated via GEMINI_AUDIO_TOKENS_PER_MINUTE) per UTC day. Once
# hit, new grading/exam sessions are refused until the next day. Convert your
# desired $/day budget to a token count based on the active model's per-token
# pricing; $20/day is the confirmed starting ceiling for this deployment.
GEMINI_DAILY_TOKEN_CAP="2000000"

# ── Required for Mündlich Room 2 (AI oral exam) once the relay is deployed ─
# The relay is a SEPARATE service (muendlich-relay/) — Vercel cannot host
# it (persistent WebSocket). Deploy it (e.g. Fly.io, see muendlich-relay/
# README.md) first, then point this at its public wss:// URL. Until then
# this defaults to ws://localhost:8787 and Room 2 will not work in production.
VITE_MUENDLICH_RELAY_URL="wss://your-relay-host"
MUENDLICH_LIVE_MODEL="gemini-3.1-flash-live-preview"

# ── Optional (Mündlich voice call — TURN relay) ──────────────────────────
# STUN is always used (primary). Set these to use your OWN TURN server in
# production (recommended); if unset, a public OpenRelay TURN is used as
# fallback so voice still works on restrictive/symmetric-NAT networks.
# Comma-separated turn:/turns: URLs.
VITE_TURN_URLS="turn:your-turn-host:3478,turns:your-turn-host:443?transport=tcp"
VITE_TURN_USERNAME="your-turn-username"
VITE_TURN_CREDENTIAL="your-turn-credential"
