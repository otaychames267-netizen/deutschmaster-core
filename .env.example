# AuraLingovia — environment variables template
# Copy this file to .env and fill in your values.

# ── Required (client-side) ────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Get from: Supabase Dashboard → Settings → API → anon public (the JWT key)
VITE_SUPABASE_ANON_KEY="eyJ..."

# ── Required (server-side only) ──────────────────────────────────────────
SUPABASE_URL="https://your-project-id.supabase.co"
# Get from: Supabase Dashboard → Settings → API → service_role secret key
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Optional (PDF import + essay grading + Mündlich evaluation) ──────────
# ANTHROPIC_API_KEY, if set, is preferred over Gemini for PDF import vision
# (see VISION_PROVIDER). GRADING_MODEL/essay-grader.ts (Claude) is kept as an
# unused fallback reference — the live Schreiben grader is now Gemini-based
# (essay-grader-gemini.ts, GRADING_MODEL_GEMINI below), so ANTHROPIC_API_KEY
# is no longer required for grading, only for PDF import vision if selected.
ANTHROPIC_API_KEY="sk-ant-..."
GRADING_MODEL="claude-sonnet-5"
GEMINI_API_KEY="your-gemini-api-key"
GRADING_MODEL_GEMINI="gemini-2.5-flash"
MUENDLICH_EVAL_MODEL="gemini-2.5-flash"
# "claude" or "gemini" — which PDF-import vision provider to use. Defaults to
# claude if ANTHROPIC_API_KEY is set, otherwise gemini.
VISION_PROVIDER=""

# ── Global Gemini API spend cap (see api_usage_ledger / get_today_api_usage) ─
# Approximate token ceiling for combined Gemini usage (essay grading + Mündlich
# Live audio, estimated via GEMINI_AUDIO_TOKENS_PER_MINUTE) per UTC day. Once
# hit, new grading/exam sessions are refused until the next day. Convert your
# desired $/day budget to a token count based on the active model's per-token
# pricing; $20/day is the confirmed starting ceiling for this deployment.
GEMINI_DAILY_TOKEN_CAP="2000000"

# ── Lemon Squeezy payments (the real payment processor — Stripe was never
# actually built, only scaffolded, and that scaffold has been removed) ─────
# Get these from your Lemon Squeezy dashboard once your store is approved.
# Placeholders are safe to leave until then — the checkout/webhook code is
# built ahead of real keys and simply returns 503 without them.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# One Lemon Squeezy Variant ID per tier — create the 3 subscription products/
# variants in the dashboard first, then paste their IDs here.
LEMONSQUEEZY_VARIANT_SCHRIFTLICH=""
LEMONSQUEEZY_VARIANT_MUENDLICH=""
LEMONSQUEEZY_VARIANT_KOMPLETT=""
# Static conversion rate used at checkout-session creation to bill the TND
# price (see the `plans` table) in the checkout currency — no live-rate API,
# matching this repo's existing static-price-column convention. Update
# manually as needed; this is NOT read anywhere else.
TND_TO_USD_RATE="3.1"

# ── Required for Mündlich Room 2 (AI oral exam) once the relay is deployed ─
# The relay is a SEPARATE service (muendlich-relay/) — Vercel cannot host
# it (persistent WebSocket). Deploy it (e.g. Fly.io, see muendlich-relay/
# README.md) first, then point this at its public wss:// URL. Until then
# this defaults to ws://localhost:8787 and Room 2 will not work in production.
VITE_MUENDLICH_RELAY_URL="wss://your-relay-host"
MUENDLICH_LIVE_MODEL="gemini-3.1-flash-live-preview"

# ── D17 verification: email + operational alerting (build-ahead-of-credentials,
# same pattern as Lemon Squeezy — no-op/log cleanly until real keys are set) ──
# Resend (https://resend.com) — used for payment status emails (approved/
# manual-review/rejected) and operational alert emails. Plain REST call, no SDK.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AuraLingovia <noreply@auralingovia.com>"
# Telegram Bot API — used for real-time D17 operational alerts (Gemini
# failures, high-risk rejection clusters, budget-cap warnings). Create a bot
# via @BotFather, then message it once and use https://api.telegram.org/bot<token>/getUpdates
# to find your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Optional — if set, alert emails are also sent here in addition to Telegram.
ADMIN_ALERT_EMAIL=""
# Perceptual-hash Hamming-distance threshold for "near-duplicate" screenshot
# detection (0-64, lower = stricter). Tune after observing real submissions.
DHASH_DUPLICATE_THRESHOLD="10"
# Max verification submissions per user per hour, across all their orders —
# protects the shared Gemini budget from a scripted-abuse burst.
D17_HOURLY_SUBMISSION_LIMIT="5"

# ── D17/bank-transfer manual payment verification (parallel to Lemon Squeezy) ─
# Read server-side only and snapshotted onto each new order (so historical
# orders stay auditable even if these change later) — never a VITE_ var, the
# client gets them back in createD17Order's response instead, avoiding a
# second source of truth. Safe to leave as placeholders; the D17 payment
# path works regardless (just shows "not yet configured" style values).
D17_OFFICIAL_NUMBER=""
D17_OFFICIAL_IBAN=""
# Shown on the payment status page's "Contact support" mailto link.
VITE_SUPPORT_EMAIL="support@auralingovia.com"

# ── Optional (Mündlich voice call — TURN relay) ──────────────────────────
# STUN is always used (primary). Set these to use your OWN TURN server in
# production (recommended); if unset, a public OpenRelay TURN is used as
# fallback so voice still works on restrictive/symmetric-NAT networks.
# Comma-separated turn:/turns: URLs.
VITE_TURN_URLS="turn:your-turn-host:3478,turns:your-turn-host:443?transport=tcp"
VITE_TURN_USERNAME="your-turn-username"
VITE_TURN_CREDENTIAL="your-turn-credential"
