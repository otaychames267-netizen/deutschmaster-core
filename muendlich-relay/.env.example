SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
PORT=8787

# Which live-exam voice backend to run. "gemini" (default) = original
# Gemini-Live-only pipeline (geminiLive.ts), unchanged. "elevenlabs" = the
# Claude (conversation) + ElevenLabs v3 (speech) pipeline in src/voice/.
# Safe instant rollback: flip this back to "gemini" (or unset it) and
# redeploy — no code change needed.
MUENDLICH_VOICE_BACKEND=gemini

# Used by the post-exam evaluator (muendlich-evaluator.ts) always, and by the
# live examiner conversation loop when MUENDLICH_VOICE_BACKEND=elevenlabs.
ANTHROPIC_API_KEY=
# Temporary dev key — replace before any real production traffic. Only ever
# read server-side (src/voice/elevenLabsTts.ts, elevenLabsStt.ts); never sent
# to the browser.
ELEVENLABS_API_KEY=
CLAUDE_EXAMINER_MODEL=claude-sonnet-5
# Live, latency-sensitive dynamic speech (organic follow-ups, takeover
# questions, nudges) — standard streaming endpoint. Flash v2.5 by default:
# ElevenLabs' own docs say v3 has materially higher first-token latency and
# is not recommended for real-time/conversational use (their own Agents
# Platform excludes it). Also half the $/1000-char rate of v3. See
# src/voice/elevenLabsTts.ts's header comment for the full reasoning.
ELEVENLABS_DYNAMIC_TTS_MODEL=eleven_flash_v2_5
# Used ONLY by (a) the optional Text-to-Dialogue A/B path
# (openDialogueConnection/startDialogueSynthesis) and (b) offline
# pre-generation of the fixed phrase library (synthesizeOnce) — never on the
# live per-turn path. v3's richer expressiveness is worth paying for once,
# offline, where latency doesn't matter.
ELEVENLABS_DIALOGUE_MODEL=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v2_realtime

# Google Cloud hybrid path (src/voice/googleTts.ts, googleStt.ts) — NOT YET
# WIRED into the live orchestrator, code is ready-but-blocked pending this
# credential. Path to a GCP service-account JSON key with the
# Text-to-Speech + Speech-to-Text APIs enabled on the project. The
# @google-cloud/* client libraries read this automatically — no other code
# needed. See voice/README.md for why this vendor is needed at all.
GOOGLE_APPLICATION_CREDENTIALS=

# Self-hosted German STT (src/voice/whisperStt.ts + ../whisper-server/) —
# THE recommended STT path per the final cost model (finalCostModel.mjs):
# at real student-response durations, ElevenLabs/Google STT both cost more
# than the entire $10/participant/month budget by themselves; self-hosted
# costs ~$0.01/exam. Set MUENDLICH_STT_BACKEND=whisper to switch candidate
# STT from ElevenLabs Scribe to this service; default (unset, or any other
# value) stays on ElevenLabs for safety/backward compatibility. Requires
# WHISPER_STT_URL pointing at a deployed whisper-server instance — see
# ../whisper-server/README.md for deployment steps. NOT YET DEPLOYED
# anywhere reachable from this repo.
MUENDLICH_STT_BACKEND=elevenlabs
WHISPER_STT_URL=

# Hard idle-close: end a room outright if BOTH participants stay silent (even
# through the AI's own shorter per-Teil nudge attempts) for this long, ms.
MUENDLICH_HARD_IDLE_MS=45000
# Approximate Gemini Live audio token rate used to estimate cost-cap ledger
# usage at session end (Live API doesn't expose per-request token counts).
GEMINI_AUDIO_TOKENS_PER_MINUTE=3840
# Same daily token ceiling as the main app's GEMINI_DAILY_TOKEN_CAP — keep
# these two in sync manually, they gate the same global budget.
GEMINI_DAILY_TOKEN_CAP=2000000
