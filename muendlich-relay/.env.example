SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Used only by the post-exam evaluator (muendlich-evaluator.ts) — the live
# AI-examiner voice session during the exam itself still runs on Gemini Live
# (GEMINI_API_KEY above), which has no Claude equivalent.
ANTHROPIC_API_KEY=
PORT=8787

# Hard idle-close: end a room outright if BOTH participants stay silent (even
# through the AI's own shorter per-Teil nudge attempts) for this long, ms.
MUENDLICH_HARD_IDLE_MS=45000
# Approximate Gemini Live audio token rate used to estimate cost-cap ledger
# usage at session end (Live API doesn't expose per-request token counts).
GEMINI_AUDIO_TOKENS_PER_MINUTE=3840
# Same daily token ceiling as the main app's GEMINI_DAILY_TOKEN_CAP — keep
# these two in sync manually, they gate the same global budget.
GEMINI_DAILY_TOKEN_CAP=2000000
